# Copy this file to .env and fill in real values. Never commit .env.

# Used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database connection. Defaults to a local SQLite file when unset.
# For PostgreSQL (production), use a URL like:
#   postgresql://user:password@localhost:5432/scheduling
# DATABASE_URL=postgresql://scheduling:scheduling@localhost:5432/scheduling

# Base URL of the frontend, used to build links in emails (e.g. manage appointment)
FRONTEND_URL=http://localhost:5173

# SMTP for transactional emails (booking confirmation, reminders).
# If SMTP_HOST is unset, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
