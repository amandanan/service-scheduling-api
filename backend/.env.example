# Copy this file to .env and fill in real values. Never commit .env.

# Used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database connection. Defaults to a local SQLite file when unset.
# For PostgreSQL (production), use a URL like:
#   postgresql://user:password@localhost:5432/scheduling
# DATABASE_URL=postgresql://scheduling:scheduling@localhost:5432/scheduling
