# Copy this file to .env and fill in real values. Never commit .env.

# Used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database connection. Defaults to a local SQLite file when unset.
# For PostgreSQL (production), use a URL like:
#   postgresql://user:password@localhost:5432/scheduling
# DATABASE_URL=postgresql://scheduling:scheduling@localhost:5432/scheduling

# Base URL of the frontend, used to build links in emails (e.g. manage appointment)
FRONTEND_URL=http://localhost:5173

# SMTP for transactional emails (booking confirmation, reminders).
# If SMTP_HOST is unset, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# WhatsApp confirmation messages. If WHATSAPP_API_URL is unset, messages are
# logged instead of sent (dev/test). Pick the provider that matches your setup:
#
#   WHATSAPP_PROVIDER=zapi       -> body {phone, message}, header Client-Token
#   WHATSAPP_PROVIDER=evolution  -> body {number, text},   header apikey
#   WHATSAPP_PROVIDER=generic    -> body {phone, message}, header Authorization: Bearer
#
# WHATSAPP_API_URL is the full "send text" endpoint from your provider.
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Z-API only: account security token sent in the Client-Token header.
WHATSAPP_CLIENT_TOKEN=

# Automated appointment reminders.
# Set REMINDERS_ENABLED=true to run an in-process loop that sends reminders
# for appointments happening soon. For multi-instance deploys, leave this off
# and instead run the cron job:
#   */15 * * * * cd /path/to/backend && .venv/bin/python -m app.jobs.send_reminders
REMINDERS_ENABLED=
# How many hours before the appointment a reminder goes out.
REMINDER_HOURS_BEFORE=24
# How often the in-process loop checks for due reminders (minutes).
REMINDER_INTERVAL_MINUTES=15
